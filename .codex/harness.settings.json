{
  "primaryInstallPath": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\VRisingDedicatedServer",
  "serverInstallPath": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\VRisingDedicatedServerCodex",
  "pluginDir": "BepInEx\\plugins",
  "serverExe": "VRisingServer.exe",
  "persistentDataRoot": ".codex\\persistent-data",
  "logFiles": [
    "BepInEx\\LogOutput.log"
  ],
  "timeouts": {
    "readinessSeconds": 300,
    "shutdownSeconds": 15
  },
  "profiles": {
    "bloodcraft-smoke": {
      "modId": "bloodcraft",
      "pluginName": "Bloodcraft",
      "buildScript": ".codex\\install.sh",
      "builtDllPath": "bin\\Release\\net6.0\\Bloodcraft.dll",
      "requiredPlugins": [
        {
          "source": "{PrimaryInstallPath}\\BepInEx\\plugins\\VampireCommandFramework.dll"
        },
        {
          "source": "{PrimaryInstallPath}\\BepInEx\\plugins\\NetTopologySuite.dll"
        }
      ],
      "cleanupPlugins": [
        "Bloodcraft.dll",
        "Bloodstone.dll",
        "Emberglass.dll",
        "FinishZone.dll",
        "HookDOTS.API.dll",
        "KindredCommands.dll",
        "KindredExtract.dll",
        "KindredInnkeeper.dll",
        "KindredLogistics.dll",
        "KindredPortals.dll",
        "KindredSacrifice.dll",
        "KindredSchematics.dll",
        "KinImmortal.dll",
        "KinLootBGone.dll",
        "KinPonds.dll",
        "KinPoolParty.dll",
        "KinThrone.dll",
        "Penumbra.dll",
        "VRising.DataExtractor.dll",
        "VRoles.dll"
      ],
      "snapshotPaths": [
        "{PersistentDataPath}\\Settings",
        "{ServerInstallPath}\\BepInEx\\config\\Bloodcraft"
      ],
      "arguments": [
        "-persistentDataPath",
        "{PersistentDataPath}",
        "-saveName",
        "{SaveName}",
        "-serverName",
        "Codex Bloodcraft Smoke",
        "-gamePort",
        "28015",
        "-queryPort",
        "28016",
        "-listOnSteam",
        "false",
        "-listOnEOS",
        "false",
        "-lanMode",
        "true",
        "-logFile",
        "{ServerLogPath}"
      ],
      "successMarkers": [
        "(Bloodcraft\\[[^\\]]+\\] loaded!|\\[Info\\s+:Bloodcraft\\]\\s+Loaded \\[[^\\]]+\\])",
        "(Bloodcraft\\[[^\\]]+\\] initialized!|\\[Info\\s+:Bloodcraft\\]\\s+Initialized \\[[^\\]]+\\])"
      ],
      "failureMarkers": [
        "Bloodcraft\\[[^\\]]+\\] fatal init failure",
        "There is no Server world!",
        "Server world is not ready yet",
        "generic and can't be used in il2cpp"
      ],
      "expectedPluginVersions": {
        "Bloodcraft": "1.13.22"
      },
      "expectedVraVersion": "1.1.12-r99041-b2",
      "buildEnvironment": {
        "BEPINEX_PLUGIN_DIR": ""
      }
    }
  }
}
